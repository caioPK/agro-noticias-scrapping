# ── Fonte de Dados ─────────────────────────────────────────
# Escolha: "excel" (arquivo local) ou "sheets" (Google Sheets API)
DATA_SOURCE=excel

# ── Excel Local (usado quando DATA_SOURCE=excel) ──────────
# Caminho para o arquivo .xlsx
EXCEL_FILE_PATH=./data.xlsx

# ── Google Sheets (usado quando DATA_SOURCE=sheets) ───────
# ID da planilha Google Sheets (extraído da URL da planilha)
# Exemplo: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=sua_spreadsheet_id_aqui

# Caminho para o arquivo JSON da Service Account do Google Cloud
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials.json

# ── Configurações Comuns ──────────────────────────────────
# Nome da aba da planilha (ex: "Sheet1", "Página1")
SHEET_NAME=Sheet1

# Coluna que contém as URLs (ex: A)
URL_COLUMN=A

# Coluna onde o resultado será escrito (ex: B)
OUTPUT_COLUMN=B

# Linha inicial (1 = primeira linha, 2 = pula cabeçalho)
START_ROW=2

# Tempo máximo de espera para carregar a página (em milissegundos)
PAGE_TIMEOUT=30000

# Tempo de espera entre cada requisição (em milissegundos) - para evitar bloqueios
DELAY_BETWEEN_REQUESTS=2000
